<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.lacework.codesec</groupId>
  <artifactId>codesec-testbed-maven</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <dependencies>
    <!-- GHSA-jfh8-c2jp-5v3q  CVE-2021-44228  critical  (Log4Shell)
         vulnerable: >= 2.13.0, < 2.15.0   fixed: 2.15.0   lowest fully clean: 2.17.1 -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.14.1</version>
    </dependency>

    <!-- GHSA-rmj7-2vxq-3g9f  CVE-2026-54513  high
         vulnerable: >= 2.10.0, < 2.18.8   fixed: 2.18.8 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.13.0</version>
    </dependency>

    <!-- GHSA-2qrg-x229-3v8q  CVE-2019-17571  critical  (Log4j 1.x, EOL)
         SocketServer deserialises untrusted input -> RCE. The 1.x line was
         never patched, so there is no fixed version; 2.17.1+ is the way out.
         Same pin also matches CVE-2022-23305 and CVE-2022-23307 (critical),
         CVE-2021-4104 (JMSAppender, the 1.x analogue of Log4Shell),
         CVE-2022-23302 and CVE-2023-26464. -->
    <dependency>
      <groupId>log4j</groupId>
      <artifactId>log4j</artifactId>
      <version>1.2.17</version>
    </dependency>
  </dependencies>
</project>
